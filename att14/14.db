SELECT * FROM livros;

SELECT l.titulo, a.nome AS autor 
FROM livros l 
JOIN autores a ON l.autor_id = a.id;

SELECT l.titulo 
FROM livros l 
JOIN autores a ON l.autor_id = a.id 
WHERE a.nome = 'George Orwell';

SELECT * FROM livros 
ORDER BY titulo ASC;

SELECT * FROM livros 
WHERE disponivel = TRUE;